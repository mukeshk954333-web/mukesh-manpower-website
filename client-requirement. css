/* ==========================================
   MUKESH MANPOWER
   CLIENT REQUIREMENT SECTION
   Brand: Red + Blue + Black + White
   ========================================== */

:root {
    --mm-red: #DC0000;
    --mm-red-dark: #A80000;

    --mm-blue: #002D60;
    --mm-blue-light: #064A91;

    --mm-black: #000000;
    --mm-dark: #050505;
    --mm-card-dark: #0D1117;

    --mm-white: #FFFFFF;
    --mm-bg: #F8FAFC;

    --mm-border: #E2E8F0;
    --mm-text: #0F172A;
    --mm-muted: #64748B;

    --mm-radius: 14px;
    --mm-transition: all 0.3s ease;
}


/* SECTION */

.mm-client-section {
    background:
        linear-gradient(
            180deg,
            #F8FAFC 0%,
            #FFFFFF 100%
        );

    padding: 90px 16px;

    font-family:
        'Plus Jakarta Sans',
        sans-serif;

    position: relative;

    overflow: hidden;
}


/* Decorative Top Line */

.mm-client-section::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    height: 4px;

    background:
        linear-gradient(
            90deg,
            var(--mm-red) 0%,
            var(--mm-red) 45%,
            var(--mm-blue) 55%,
            var(--mm-blue) 100%
        );
}


/* CONTAINER */

.mm-client-container {
    max-width: 1240px;
    margin: 0 auto;
}


/* HEADER */

.mm-client-header {
    text-align: center;

    max-width: 760px;

    margin:
        0 auto 55px;
}


.mm-client-badge {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    background: var(--mm-white);

    border: 1px solid var(--mm-border);

    color: var(--mm-blue);

    padding: 7px 16px;

    border-radius: 999px;

    font-size: 12px;

    font-weight: 700;

    box-shadow:
        0 2px 6px rgba(0,0,0,.05);
}


.mm-client-badge-dot {

    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--mm-red);

    box-shadow:
        0 0 0 4px rgba(220,0,0,.10);
}


.mm-client-title {

    margin:
        18px 0 12px;

    font-size: 38px;

    line-height: 1.2;

    font-weight: 800;

    color: var(--mm-blue);

    letter-spacing: -0.6px;
}


.mm-client-title span {
    color: var(--mm-red);
}


.mm-client-divider {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 12px;

    margin: 15px 0;
}


.mm-client-divider span {

    width: 55px;

    height: 2px;

    background: var(--mm-blue);
}


.mm-client-divider i {

    color: var(--mm-red);

    font-size: 17px;
}


.mm-client-subtitle {

    color: var(--mm-muted);

    font-size: 15px;

    line-height: 1.7;

    margin: 0;
}


/* MAIN GRID */

.mm-client-grid {

    display: grid;

    grid-template-columns:
        minmax(0, .9fr)
        minmax(0, 1.1fr);

    gap: 35px;

    align-items: stretch;
}


/* LEFT INFORMATION */

.mm-client-info {

    background:
        linear-gradient(
            145deg,
            var(--mm-blue),
            #031B3A
        );

    border-radius: 20px;

    padding: 35px;

    color: white;

    position: relative;

    overflow: hidden;

    box-shadow:
        0 20px 35px rgba(0,45,96,.18);
}


.mm-client-info::after {

    content: "";

    position: absolute;

    width: 220px;
    height: 220px;

    right: -100px;
    bottom: -100px;

    border-radius: 50%;

    border: 35px solid
        rgba(220,0,0,.15);
}


.mm-client-info-head {

    display: flex;

    align-items: center;

    gap: 16px;

    padding-bottom: 25px;

    border-bottom:
        1px solid rgba(255,255,255,.15);

    position: relative;

    z-index: 2;
}


.mm-client-info-icon {

    width: 58px;
    height: 58px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    background: var(--mm-red);

    color: white;

    border-radius: 12px;

    font-size: 24px;

    box-shadow:
        0 8px 20px rgba(220,0,0,.25);
}


.mm-client-info-head h3 {

    margin: 0 0 4px;

    font-size: 21px;

    font-weight: 800;
}


.mm-client-info-head p {

    margin: 0;

    font-size: 13px;

    color: #CBD5E1;
}


/* REQUIREMENT ITEMS */

.mm-requirement-points {

    margin-top: 25px;

    display: flex;

    flex-direction: column;

    gap: 20px;

    position: relative;

    z-index: 2;
}


.mm-requirement-item {

    display: flex;

    gap: 13px;

    align-items: flex-start;
}


.mm-requirement-icon {

    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        rgba(220,0,0,.12);

    color: #FF4A4A;

    border:
        1px solid rgba(220,0,0,.30);

    border-radius: 9px;

    font-size: 15px;
}


.mm-requirement-item h4 {

    margin: 0 0 3px;

    font-size: 14px;

    font-weight: 700;

    color: white;
}


.mm-requirement-item p {

    margin: 0;

    font-size: 12px;

    line-height: 1.5;

    color: #CBD5E1;
}


/* DIRECT CONTACT */

.mm-client-direct {

    margin-top: 30px;

    padding: 17px;

    background:
        rgba(0,0,0,.25);

    border:
        1px solid rgba(255,255,255,.10);

    border-radius: 12px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    position: relative;

    z-index: 2;
}


.mm-client-direct span {

    display: block;

    font-size: 11px;

    color: #CBD5E1;

    margin-bottom: 3px;
}


.mm-client-direct strong {

    display: block;

    font-size: 17px;

    color: white;
}


.mm-client-direct a {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 9px 13px;

    background: var(--mm-red);

    color: white;

    text-decoration: none;

    border-radius: 8px;

    font-size: 12px;

    font-weight: 700;

    transition: var(--mm-transition);
}


.mm-client-direct a:hover {

    background: var(--mm-red-dark);

    transform: translateY(-2px);
}


/* FORM CARD */

.mm-client-form-card {

    background: white;

    border:
        1px solid var(--mm-border);

    border-radius: 20px;

    padding: 35px;

    box-shadow:
        0 10px 30px rgba(15,23,42,.07);
}


/* FORM HEADER */

.mm-form-heading {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    padding-bottom: 20px;

    margin-bottom: 24px;

    border-bottom:
        1px solid var(--mm-border);
}


.mm-form-heading h3 {

    margin: 0 0 4px;

    color: var(--mm-blue);

    font-size: 20px;

    font-weight: 800;
}


.mm-form-heading p {

    margin: 0;

    color: var(--mm-muted);

    font-size: 12px;
}


.mm-form-status {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 5px 9px;

    border-radius: 6px;

    background: #F1F5F9;

    color: var(--mm-blue);

    font-size: 10px;

    font-weight: 800;
}


.mm-form-status i {

    color: #16A34A;

    font-size: 7px;
}


/* FORM */

.mm-form-group {

    margin-bottom: 18px;
}


.mm-form-group label {

    display: block;

    margin-bottom: 7px;

    color: var(--mm-text);

    font-size: 12px;

    font-weight: 700;
}


.mm-input-box {

    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 48px;

    padding: 0 14px;

    border:
        1px solid var(--mm-border);

    background: #FAFAFA;

    border-radius: 9px;

    transition: var(--mm-transition);
}


.mm-input-box i {

    color: var(--mm-blue);

    font-size: 14px;

    width: 18px;

    text-align: center;
}


.mm-input-box input,
.mm-input-box select {

    width: 100%;

    height: 46px;

    border: none;

    outline: none;

    background: transparent;

    color: var(--mm-text);

    font-family: inherit;

    font-size: 13px;
}


.mm-input-box select {

    cursor: pointer;
}


.mm-input-box:focus-within {

    border-color:
        var(--mm-blue-light);

    background: white;

    box-shadow:
        0 0 0 3px rgba(6,74,145,.08);
}


/* FORM ROW */

.mm-form-row {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 15px;
}


/* TEXTAREA */

.mm-form-group textarea {

    width: 100%;

    box-sizing: border-box;

    padding: 12px 14px;

    border:
        1px solid var(--mm-border);

    border-radius: 9px;

    resize: vertical;

    outline: none;

    background: #FAFAFA;

    color: var(--mm-text);

    font-family: inherit;

    font-size: 13px;

    line-height: 1.5;

    transition: var(--mm-transition);
}


.mm-form-group textarea:focus {

    border-color:
        var(--mm-blue-light);

    background: white;

    box-shadow:
        0 0 0 3px rgba(6,74,145,.08);
}


/* SUBMIT BUTTON */

.mm-client-submit {

    width: 100%;

    border: none;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 10px;

    padding: 14px 18px;

    border-radius: 9px;

    background: var(--mm-red);

    color: white;

    font-family: inherit;

    font-size: 14px;

    font-weight: 800;

    transition: var(--mm-transition);

    box-shadow:
        0 8px 18px rgba(220,0,0,.18);
}


.mm-client-submit:hover {

    background: var(--mm-red-dark);

    transform: translateY(-2px);

    box-shadow:
        0 12px 24px rgba(220,0,0,.24);
}


/* WHATSAPP */

.mm-whatsapp-option {

    margin-top: 10px;

    width: 100%;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    padding: 12px;

    border-radius: 9px;

    background: #EAFBF1;

    border:
        1px solid #BCEFD0;

    color: #15803D;

    text-decoration: none;

    font-size: 12px;

    font-weight: 700;

    transition: var(--mm-transition);
}


.mm-whatsapp-option:hover {

    background: #25D366;

    color: white;

    border-color: #25D366;
}


.mm-whatsapp-option i {

    font-size: 18px;
}


/* RESPONSIVE */

@media (max-width: 900px) {

    .mm-client-grid {

        grid-template-columns: 1fr;

    }

}


@media (max-width: 639px) {

    .mm-client-section {

        padding: 55px 12px;

    }


    .mm-client-title {

        font-size: 29px;

    }


    .mm-client-subtitle {

        font-size: 13px;

    }


    .mm-client-info,
    .mm-client-form-card {

        padding: 23px 18px;

        border-radius: 15px;

    }


    .mm-form-row {

        grid-template-columns: 1fr;

        gap: 0;

    }


    .mm-client-direct {

        flex-direction: column;

        align-items: stretch;

        text-align: center;

    }


    .mm-client-direct a {

        justify-content: center;

    }


    .mm-form-heading {

        align-items: flex-start;

        flex-direction: column;

    }

  }
